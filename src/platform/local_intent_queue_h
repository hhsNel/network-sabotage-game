#ifndef LOCAL_INTENT_QUEUE_H
#define LOCAL_INTENT_QUEUE_H

#include <stdbool.h>

enum platform_command_type {
    PLATFORM_COMMAND_NODE_BOUGHT,
    PLATFORM_COMMAND_NODE_FLASHED,
    PLATFORM_COMMAND_NODE_RESET
};

struct platform_client_command {
    enum platform_command_type type;

    union {
        struct {
            int x;
            int y;
            int node_type;
        } bought;

        struct {
            int x;
            int y;
            const char *code;
        } flashed;

        struct {
            int x;
            int y;
        } reset;
    } data;
};

struct platform_server_command {
};

struct platform;

struct platform *platform_create(void);
void platform_destroy(struct platform *platform);

bool platform_send(
    struct platform *platform,
    struct platform_client_command command
);

bool platform_has_client_command(
    const struct platform *platform
);

bool platform_receive_client_command(
    struct platform *platform,
    struct platform_client_command *command
);

bool platform_has_server_command(
    const struct platform *platform
);

bool platform_receive_server_command(
    struct platform *platform,
    struct platform_server_command *command
);

#endif
